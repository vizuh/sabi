{
  "provenance": "Nous-first Hermes profile. Cheap tier is poolside/laguna-s-2.1:free (262144 context, verified live 2026-09-21 against the Nous inference catalog of 402 models) served through the Hermes-managed Nous proxy below, so Hermes holds its own OAuth and Sabi never sees it. transportFallback retries 429/402/403 adaptive rounds cost-ordered (free first). Mid/strong stay OpenRouter and fail until that balance is funded. Copy to $SABI_CONFIG; start the proxies first.",
  "server": { "host": "127.0.0.1", "port": 8787 },
  "upstreams": {
    "nous-local": {
      "baseURL": "http://127.0.0.1:8645/v1",
      "apiKey": false,
      "streamUsage": true
    },
    "openrouter": {
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "streamUsage": true,
      "headers": {
        "HTTP-Referer": "https://github.com/vizuh/sabi",
        "X-Title": "Sabi"
      }
    },
    "ollama": {
      "baseURL": "http://127.0.0.1:11434/v1",
      "apiKey": false,
      "streamUsage": false
    }
  },
  "models": {
    "cheap": {
      "upstream": "nous-local",
      "model": "poolside/laguna-s-2.1:free",
      "contextWindow": 262144,
      "capabilities": { "inputModalities": ["text"] },
      "cost": { "input": 0, "output": 0, "cacheRead": 0 }
    },
    "mid": {
      "upstream": "openrouter",
      "model": "openai/gpt-5.6-luna",
      "contextWindow": 1050000,
      "maxOutputTokens": 128000,
      "capabilities": { "inputModalities": ["text", "image", "file"] },
      "cost": { "input": 0.2, "output": 1.2, "cacheRead": 0.02 }
    },
    "strong": {
      "upstream": "openrouter",
      "model": "anthropic/claude-sonnet-5",
      "contextWindow": 1000000,
      "maxOutputTokens": 128000,
      "capabilities": { "inputModalities": ["text", "image", "file"] },
      "cost": { "input": 2, "output": 10, "cacheRead": 0.2 }
    },
    "local": {
      "upstream": "ollama",
      "model": "qwen2.5-coder:7b",
      "contextWindow": 32768,
      "capabilities": { "inputModalities": ["text"] },
      "cost": { "input": 0, "output": 0 }
    }
  },
  "aliases": {
    "sabi-code": "auto",
    "sabi-cheap": "cheap",
    "sabi-mid": "mid",
    "sabi-strong": "strong",
    "sabi-local": "local"
  },
  "policy": {
    "failure": "strong",
    "stuck": "mid",
    "context-pressure": "mid",
    "transport": "mid",
    "first-turn": "mid",
    "verification": "mid",
    "implementation": "mid",
    "exploration": "cheap",
    "unclassified": "cheap"
  },
  "transportFallback": {
    "enabled": true
  },
  "telemetry": {
    "allowlistOnly": true,
    "captureSnippets": false,
    "captureChars": 800
  }
}
