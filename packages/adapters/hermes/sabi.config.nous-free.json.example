{
  "provenance": "Operator rule (2026-09-22): OpenRouter may serve FREE models only. Cheap tier is poolside/laguna-s-2.1:free (262144 context, verified live 2026-09-21 against the Nous inference catalog of 402 models) served through the Hermes-managed Nous proxy below, so Hermes holds its own OAuth and Sabi never sees it. transportFallback retries 429/402/403 adaptive rounds cost-ordered (free first). Mid/strong are free OpenRouter :free ids with cost 0 and the openrouter upstream declares paidModelsAllowed:false, so a priced model id is refused at dispatch. Jev (TypeSafe judge) is a separate upstream and unaffected. Copy to $SABI_CONFIG; start the proxies first.",
  "server": { "host": "127.0.0.1", "port": 8787 },
  "upstreams": {
    "nous-local": {
      "baseURL": "http://127.0.0.1:8645/v1",
      "apiKey": false,
      "streamUsage": true
    },
    "openrouter": {
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "streamUsage": true,
      "paidModelsAllowed": false,
      "headers": {
        "HTTP-Referer": "https://github.com/vizuh/sabi",
        "X-Title": "Sabi"
      }
    },
    "ollama": {
      "baseURL": "http://127.0.0.1:11434/v1",
      "apiKey": false,
      "streamUsage": false
    }
  },
  "models": {
    "cheap": {
      "upstream": "nous-local",
      "model": "poolside/laguna-s-2.1:free",
      "contextWindow": 262144,
      "capabilities": { "inputModalities": ["text"] },
      "cost": { "input": 0, "output": 0, "cacheRead": 0 }
    },
    "mid": {
      "upstream": "openrouter",
      "model": "dots-studio/dots-3-note-preview:free",
      "contextWindow": 512000,
      "maxOutputTokens": 460800,
      "capabilities": { "inputModalities": ["text", "image"] },
      "cost": { "input": 0, "output": 0 }
    },
    "strong": {
      "upstream": "openrouter",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "contextWindow": 1000000,
      "maxOutputTokens": 65536,
      "capabilities": { "inputModalities": ["text"] },
      "cost": { "input": 0, "output": 0 }
    },
    "local": {
      "upstream": "ollama",
      "model": "qwen2.5-coder:7b",
      "contextWindow": 32768,
      "capabilities": { "inputModalities": ["text"] },
      "cost": { "input": 0, "output": 0 }
    }
  },
  "aliases": {
    "sabi-code": "auto",
    "sabi-cheap": "cheap",
    "sabi-mid": "mid",
    "sabi-strong": "strong",
    "sabi-local": "local"
  },
  "policy": {
    "failure": "strong",
    "stuck": "mid",
    "context-pressure": "mid",
    "transport": "mid",
    "first-turn": "mid",
    "verification": "mid",
    "implementation": "mid",
    "exploration": "cheap",
    "unclassified": "cheap"
  },
  "transportFallback": {
    "enabled": true
  },
  "telemetry": {
    "allowlistOnly": true,
    "captureSnippets": false,
    "captureChars": 800
  }
}
