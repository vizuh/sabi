{
  "provenance": "OpenRouter-backed Hermes profile. Model ids are a dated recommendation, not an entitlement check; refresh the OpenRouter catalog before relying on a tier.",
  "server": { "host": "127.0.0.1", "port": 8787 },
  "upstreams": {
    "openrouter": {
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "streamUsage": true,
      "headers": {
        "HTTP-Referer": "https://github.com/vizuh/sabi",
        "X-Title": "Sabi"
      }
    }
  },
  "models": {
    "cheap": {
      "upstream": "openrouter",
      "model": "deepseek/deepseek-v4-flash-0731",
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "capabilities": { "inputModalities": ["text"] }
    },
    "mid": {
      "upstream": "openrouter",
      "model": "openai/gpt-5.6-luna",
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "capabilities": { "inputModalities": ["text", "image", "file"] }
    },
    "strong": {
      "upstream": "openrouter",
      "model": "anthropic/claude-sonnet-5",
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "capabilities": { "inputModalities": ["text", "image", "file"] }
    }
  },
  "aliases": {
    "sabi-code": "auto",
    "sabi-cheap": "cheap",
    "sabi-mid": "mid",
    "sabi-strong": "strong"
  },
  "policy": {
    "failure": "strong",
    "stuck": "mid",
    "context-pressure": "mid",
    "transport": "mid",
    "first-turn": "mid",
    "verification": "mid",
    "implementation": "mid",
    "exploration": "cheap",
    "unclassified": "cheap"
  },
  "telemetry": {
    "allowlistOnly": true,
    "captureSnippets": false,
    "captureChars": 800
  }
}
