{
  "name": "sabi",
  "private": true,
  "type": "module",
  "bin": {
    "sabi": "./packages/controller/src/cli.ts"
  },
  "workspaces": ["packages/*", "packages/adapters/*"],
  "engines": { "node": ">=22.6" },
  "scripts": {
    "start": "node packages/server/src/index.ts",
    "dev": "node --watch packages/server/src/index.ts",
    "test": "node --test \"packages/core/test/*.test.ts\" \"packages/server/test/*.test.ts\" \"packages/adapters/*/test/*.test.ts\" \"packages/adapters/*/test/*.test.mjs\" \"packages/evals/test/*.test.ts\" \"packages/controller/test/*.test.ts\" \"scripts/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report": "node packages/server/src/report.ts",
    "eval": "node packages/evals/src/run.ts",
    "setup": "node scripts/setup.ts",
    "backtest": "node packages/evals/src/backtest.ts",
    "controller": "node packages/controller/src/cli.ts",
    "build:controller": "node packages/controller/pack.mjs",
    "connect:command-code": "node packages/adapters/command-code/src/connect.ts",
    "connect:opencode": "node packages/adapters/opencode/src/connect.ts",
    "mod": "cmd --mod ./packages/adapters/command-code/mod/sabi.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
